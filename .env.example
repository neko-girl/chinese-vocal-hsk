# MiniMax API Credentials
# Get your API key from https://platform.minimaxi.com or https://intl.minimaxi.com
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional: Group ID (if required by your MiniMax tier/account)
MINIMAX_GROUP_ID=

# MiniMax API Base URL
# Default (Global): https://api.minimax.io/v1
# Mainland China:   https://api.minimaxi.chat/v1
MINIMAX_API_BASE=https://api.minimax.io/v1

# TTS Model Name (e.g. speech-02-hd, speech-02-turbo, speech-2.8-hd, speech-01-hd)
MINIMAX_MODEL=speech-02-hd

# Generation Scope & Voice Pairing
# Option 1: Mature Woman + Office Man (88,404 points total, fits 100% in $5 / 100k points plan)
MINIMAX_VOICES=mature_woman,office_man
MINIMAX_SKIP_PASSAGES=true

# Voice ID Mappings (defaults to MiniMax standard system presets)
# 1. Mature Woman (成熟女性)
MINIMAX_VOICE_MATURE_WOMAN=female-chengshu
# 2. Soothing Host (温润女主播 / 播音主持)
MINIMAX_VOICE_SOOTHING_HOST=presenter_female
# 3. Office Man (职场男音 / 精英青年)
MINIMAX_VOICE_OFFICE_MAN=male-qn-jingying
# 4. Tender CEO (温润/霸道总裁)
MINIMAX_VOICE_TENDER_CEO=male-qn-badao
